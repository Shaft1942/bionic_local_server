    "test:browser:llama-stream": "node scripts/browser-llama-stream.mjs",
    "test:browser:beta7-images": "node scripts/browser-beta7-images.mjs",
    "test:browser:beta7-copy": "node scripts/browser-beta7-copy.mjs",
    "test:browser:beta7-stats": "node scripts/browser-llama-stats-beta7.mjs",
    "check": "node scripts/check.mjs",
