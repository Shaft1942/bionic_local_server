{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "allowJs": true, "checkJs": false, "strict": true, "skipLibCheck": true,
    "esModuleInterop": true, "resolveJsonModule": true, "isolatedModules": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["vite/client"],
    "baseUrl": ".", "paths": { "$lib/*": ["src/lib/*"] }
  },
  "include": ["src/companion.ts", "src/lib/companion/**/*.ts", "src/lib/companion/**/*.svelte"]
}
